TABLE4_STAGE_DIR <- stage_dir
source(file.path(stage_dir, "config.R"))
source(file.path(stage_dir, "functions.R"))
config <- portfolio_config()
ensure_dir(config$output_dir)
frequency <- normalize_frequency(config$frequency)
# --- Cache check ---
# Load from the RDS cache first (faster than CSV parsing).
if (!isTRUE(config$force_recompute_portfolio) &&
file.exists(config$portfolio_premium_rds)) {
return(readRDS(config$portfolio_premium_rds))
}
# Fall back to the CSV cache if the RDS does not exist.
if (!isTRUE(config$force_recompute_portfolio) &&
file.exists(config$portfolio_premium_file)) {
return(read.csv(config$portfolio_premium_file, check.names = FALSE))
}
# --- Build portfolio returns ---
if (identical(frequency, "monthly")) {
# For monthly runs, attempt to reuse the reference portfolio output to
# avoid reconstructing premiums from daily panels.
reference <- load_reference_monthly_premiums(config)
if (!is.null(reference)) {
out <- reference
} else {
returns <- construct_portfolio_returns(config, frequency)
factors <- load_fama_factors(config, frequency)
out     <- merge(returns,
factors[, c("Period", "IndexRiskFreeRate"), drop = FALSE],
by = "Period", all.x = TRUE)
}
} else {
# For weekly (and any non-monthly) runs, always build from daily panels.
returns <- construct_portfolio_returns(config, frequency)
factors <- load_fama_factors(config, frequency)
out     <- merge(returns,
factors[, c("Period", "IndexRiskFreeRate"), drop = FALSE],
by = "Period", all.x = TRUE)
}
# The risk-free rate is required to compute excess returns.
if (!"IndexRiskFreeRate" %in% names(out)) {
stop("Portfolio premium calculation requires IndexRiskFreeRate.")
}
# Subtract risk-free rate from each portfolio return to obtain premiums.
out$HC_Premium    <- out$HC_Return    - out$IndexRiskFreeRate
out$MC_Premium    <- out$MC_Return    - out$IndexRiskFreeRate
out$LC_Premium    <- out$LC_Return    - out$IndexRiskFreeRate
out$LC_HC_Premium <- out$LC_Premium   - out$HC_Premium
# Add a Month column for the monthly case to maintain compatibility with
# downstream merge keys that look for a "Month" column.
if (identical(frequency, "monthly") && !"Month" %in% names(out)) {
out$Month <- out$Period
}
out <- out[order(out$Date), , drop = FALSE]
View(out)
save_new_dataset(out, config$portfolio_premium_file,
config$portfolio_premium_rds)
message("Portfolio premium rows: ", nrow(portfolio_premiums))
portfolio_premiums
